# ---------------------------------------------------------------- core
FDA_ENV=development                     # production enables Secure cookies
FDA_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fda
FDA_REDIS_URL=redis://localhost:6379/0
FDA_USE_CELERY=true                     # false = run jobs in a thread pool inside the API process
FDA_SECRET_KEY=                         # REQUIRED in production: long random string (signs sessions, encrypts stored credentials)
FDA_OWNER_EMAIL=owner@localhost
FDA_OWNER_PASSWORD=                     # first boot only; if empty a random one is written to storage/OWNER_CREDENTIALS.txt
FDA_CORS_ORIGINS=http://localhost:3000
FDA_PUBLIC_BASE_URL=http://localhost:8000   # used for the Google OAuth redirect URI

# ---------------------------------------------------------------- storage
FDA_STORAGE_BACKEND=local               # local | s3
FDA_STORAGE_DIR=./storage
FDA_S3_BUCKET=
FDA_S3_ENDPOINT_URL=                    # e.g. https://<account>.r2.cloudflarestorage.com or MinIO URL
FDA_S3_REGION=auto
FDA_S3_ACCESS_KEY=
FDA_S3_SECRET_KEY=
FDA_MAX_UPLOAD_MB=1024

# ---------------------------------------------------------------- tools
FDA_FFMPEG_BIN=ffmpeg
FDA_FFPROBE_BIN=ffprobe
FDA_BLENDER_BIN=blender
FDA_BLENDER_ENGINE=EEVEE                # EEVEE (falls back to CYCLES automatically) | CYCLES
FDA_BLENDER_SCALE=0.75                  # Blender renders at this fraction of output size
FDA_BLENDER_SAMPLES=                    # default 8 (EEVEE) / 12 (Cycles); raise for quality on fast machines
FDA_WHISPER_MODEL=small                 # faster-whisper model name or local model folder
FDA_RENDER_WORKERS=4                    # parallel frame-render processes per render
FDA_MAX_RETRIES=2
FDA_MAX_CONCURRENT_JOBS=2

# ---------------------------------------------------------------- provider keys (optional; can also be entered in Settings → Providers)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
RUNWAYML_API_SECRET=
LUMAAI_API_KEY=
DID_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
TAVILY_API_KEY=
YOUTUBE_API_KEY=
FDA_GOOGLE_CLIENT_ID=
FDA_GOOGLE_CLIENT_SECRET=
